{
  "name": "maui-deploy",
  "displayName": "MauiDeploy",
  "description": "A focused tools window for deploying, debugging, capturing, and inspecting .NET MAUI apps",
  "version": "2.0.0",
  "author": "FinstadProductions",
  "publisher": "FinstadProductions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vetle444/MauiDeploy.git"
  },
  "bugs": {
    "url": "https://github.com/Vetle444/MauiDeploy/issues"
  },
  "homepage": "https://github.com/Vetle444/MauiDeploy#readme",
  "keywords": [
    "maui",
    "dotnet",
    "debugger",
    "ios",
    "android",
    "hot reload"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "icon": "icon.png",
  "activationEvents": [
    "onDebug",
    "onUri",
    "onStartupFinished",
    "workspaceContains:**/*.csproj"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mauideploy",
          "title": "MAUI Deploy",
          "icon": "media/tools.svg"
        }
      ]
    },
    "views": {
      "mauideploy": [
        {
          "id": "mauideploy.tools",
          "name": "Tools",
          "type": "webview",
          "contextualTitle": "MAUI Deploy"
        }
      ]
    },
    "configuration": {
      "title": "MAUI Deploy",
      "properties": {
        "mauideploy.livePreview.alwaysOnTop": {
          "type": "boolean",
          "default": false,
          "description": "Open physical-device preview windows above other windows. Does not change the iOS Simulator window."
        },
        "mauideploy.android.fastDeployment": {
          "type": "boolean",
          "default": true,
          "description": "Use Android SDK Fast Deployment for Debug builds. Disable to embed assemblies in the APK. Applies to both Run and Debug."
        },
        "mauideploy.android.skipCompatibilityAnalyzers": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Speed up Android Debug Run and Debug builds by skipping trimming and single-file compatibility analysis. Source generators and other analyzers remain enabled. Compatibility warnings are deferred to builds with analysis enabled; Release and builds outside MAUI Deploy are unchanged."
        },
        "mauideploy.android.forceReinstall": {
          "type": "boolean",
          "default": false,
          "description": "Force Android APK reinstall on every deploy, preserving app data. Turn off to reuse unchanged installations."
        },
        "mauideploy.ios.skipCompatibilityAnalyzers": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Speed up iOS Debug Run and Debug builds by skipping trimming and single-file compatibility analysis, on simulators and physical devices. Source generators and other analyzers remain enabled. Set to false to retain the project's analysis settings. Compatibility warnings are deferred to builds with analysis enabled; Release and builds outside MAUI Deploy are unchanged."
        },
        "mauideploy.ios.useDynamicRegistrar": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Opt in to faster physical iOS Debug builds with the dynamic registrar for both Run and Debug. Disabled by default to retain the project's registrar settings. Turn this off if the app crashes; the next Run or Debug cleans and rebuilds using the project's registrar settings. Also cleans on first use. Overrides an explicit project Registrar value when enabled. Release and simulator builds are unchanged."
        },
        "mauideploy.ios.collectBinlogs": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Record local MSBuild binlogs for iOS Run builds and physical-device Debug builds. Paths appear in MAUI Deploy - iOS Performance. Logs may contain sensitive project properties; inspect before sharing."
        },
        "mauideploy.android.collectBinlogs": {
          "type": "boolean",
          "default": false,
          "description": "Record local Android MSBuild binlogs. Paths and phase timings appear in MAUI Deploy - Android Performance. Logs may contain sensitive project data."
        }
      }
    },
    "debuggers": [
      {
        "type": "mauideploy",
        "label": "MAUI Deploy",
        "runtime": "dotnet",
        "program": "./out/debugger/MauiDeploy.Debugger.dll",
        "languages": [
          "csharp"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "projectPath": {
                "type": "string"
              },
              "configuration": {
                "type": "string"
              },
              "platform": {
                "type": "string"
              },
              "framework": {
                "type": "string"
              },
              "deviceId": {
                "type": "string"
              },
              "deviceName": {
                "type": "string"
              },
              "programPath": {
                "type": "string"
              },
              "debugPort": {
                "type": "number"
              },
              "xamlHotReloadPort": {
                "type": "number"
              }
            }
          }
        }
      }
    ],
    "breakpoints": [
      {
        "language": "csharp"
      }
    ],
    "commands": [
      {
        "command": "mauideploy.openTools",
        "title": "MAUI Deploy: Open Tools",
        "icon": "$(tools)"
      },
      {
        "command": "mauideploy.deployBranch",
        "title": "MAUI Deploy: Deploy Branch or PR",
        "icon": "$(git-pull-request-go-to-changes)"
      },
      {
        "command": "mauideploy.setupBranchDeploy",
        "title": "MAUI Deploy: Set Up Branch Deployment",
        "icon": "$(settings-gear)"
      },
      {
        "command": "mauideploy.livePreview",
        "title": "MAUI Deploy: Live Device Preview",
        "icon": "$(device-desktop)"
      },
      {
        "command": "mauideploy.stopLivePreview",
        "title": "MAUI Deploy: Stop Live Device Preview",
        "icon": "$(debug-stop)"
      },
      {
        "command": "mauideploy.stopDebug",
        "title": "MAUI Deploy: Stop Debugging",
        "icon": "$(debug-stop)"
      },
      {
        "command": "mauideploy.openSettings",
        "title": "MAUI Deploy: Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "mauideploy.openLogs",
        "title": "MAUI Deploy: Open Output",
        "icon": "$(output)"
      },
      {
        "command": "mauideploy.openTerminal",
        "title": "MAUI Deploy: Open Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "mauideploy.memoryDiagnostics",
        "title": "MAUI Deploy: DUI Memory Diagnostics",
        "icon": "$(circuit-board)"
      },
      {
        "command": "mauideploy.screenshot",
        "title": "MAUI Deploy: Take Screenshot",
        "icon": "$(device-camera)"
      },
      {
        "command": "mauideploy.recordVideo",
        "title": "MAUI Deploy: Record Video",
        "icon": "$(record)"
      },
      {
        "command": "mauideploy.stopRecording",
        "title": "MAUI Deploy: Stop Recording",
        "icon": "$(debug-stop)"
      },
      {
        "command": "mauideploy.cancelRecording",
        "title": "MAUI Deploy: Cancel Recording",
        "icon": "$(close)"
      },
      {
        "command": "mauideploy.saveRecording",
        "title": "MAUI Deploy: Save Recording",
        "icon": "$(save)"
      },
      {
        "command": "mauideploy.run",
        "title": "MAUI Deploy: Run",
        "icon": "$(play)"
      },
      {
        "command": "mauideploy.runMultiple",
        "title": "MAUI Deploy: Run Multiple Targets",
        "icon": "$(run-all)"
      },
      {
        "command": "mauideploy.deployFromBin",
        "title": "MAUI Deploy: Deploy from Bin",
        "icon": "$(rocket)"
      },
      {
        "command": "mauideploy.debug",
        "title": "MAUI Deploy: Debug",
        "icon": "$(bug)"
      },
      {
        "command": "mauideploy.runTests",
        "title": "MAUI Deploy: Run Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "mauideploy.stop",
        "title": "MAUI Deploy: Stop Current Operation",
        "icon": "$(debug-stop)"
      },
      {
        "command": "mauideploy.pickProject",
        "title": "MAUI Deploy: Select Project",
        "icon": "$(file-code)"
      },
      {
        "command": "mauideploy.toggleConfig",
        "title": "MAUI Deploy: Toggle Configuration",
        "icon": "$(gear)"
      },
      {
        "command": "mauideploy.pickDevice",
        "title": "MAUI Deploy: Select Device",
        "icon": "$(device-mobile)"
      },
      {
        "command": "mauideploy.fixBuildErrorWithCopilot",
        "title": "MAUI Deploy: Ask Copilot to Fix Build Error",
        "icon": "$(sparkle)"
      },
      {
        "command": "mauideploy.cleanBinObj",
        "title": "MAUI Deploy: Clean bin/obj",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mauideploy.saveRecording",
          "when": "activeWebviewPanelId == mauideploy.recording",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mauideploy.run",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "build:memory": "npm --prefix memory-inspector run build",
    "test:memory": "npm --prefix memory-inspector test",
    "test:memory:vscode": "npm run compile && npm run build:memory && node test/memory-vscode.cjs",
    "vscode:prepublish": "npm run compile && npm run build:memory",
    "test": "npm run compile && node --test test/*.test.cjs",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "*",
    "@types/vscode": "*",
    "@vscode/vsce": "^3.9.1",
    "typescript": "*",
    "vscode-uri": "^3.1.0"
  }
}
